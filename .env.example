# PrimePlot frontend — copy to .env.local and fill in. Never commit .env.local.

# Express API base (server-only; used by the /api/v1 rewrite and server-side fetches)
BACKEND_URL=http://localhost:5030

# Public site URL (canonical links, sitemap, OG tags, JSON-LD). PLACEHOLDER — set the real
# production domain before launch, e.g. https://www.example-developer.com.bd
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines: keep false on dev/staging (robots.txt disallows everything and pages get
# noindex). Set true only on the live domain.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Map tiles (MapLibre style URL). Default: OpenFreeMap "positron" — free, no API key.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Show Unsplash/Pexels placeholder images where real media is missing
NEXT_PUBLIC_USE_PLACEHOLDERS=true

# Shared secret the API uses to call /api/revalidate (min 32 chars)
REVALIDATE_SECRET=

# Socket.IO connects straight to the API host (WebSockets don't go through the /api rewrite)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5030

# Home hero video. Empty = a free Pexels clip. Your own file: put it in public/videos/ and set
# NEXT_PUBLIC_HERO_VIDEO=/videos/hero.mp4 and NEXT_PUBLIC_HERO_POSTER=/videos/hero.jpg
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_HERO_POSTER=

# Website enquiry + landowner forms submit to POST /public/leads (B3 is live). Set false to show the forms read-only.
NEXT_PUBLIC_LEADS_ENABLED=true
